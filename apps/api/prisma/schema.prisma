generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  UPLOADED
  EXTRACTING_AUDIO
  TRANSCRIBING
  READY
  FAILED
}

model Project {
  id            String        @id @default(cuid())
  title         String
  status        ProjectStatus @default(UPLOADED)
  errorMessage  String?
  videoKey      String        @unique
  fileSizeBytes Int           @default(0)
  audioKey      String?
  exportKey     String?
  exportStatus  String?
  durationSec   Float?
  width         Int?
  height        Int?
  fps           Float?
  language      String?
  templateId    String        @default("classic")
  captions      Json          @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
}
